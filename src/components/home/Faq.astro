---
import { faqs } from '@/data/content';
---

<section id="faq" class="py-16 animate-on-scroll">
  <div class="content-container">
    <h2 class="text-title text-text mb-6">FAQ</h2>

    <div class="max-w-2xl divide-y divide-border">
      {faqs.map((faq) => (
        <details class="group py-4 first:pt-0">
          <summary
            class="flex cursor-pointer items-center justify-between gap-4 text-subtitle font-medium text-text marker:content-none [&::-webkit-details-marker]:hidden"
          >
            {faq.question}
            <svg
              class="h-5 w-5 shrink-0 text-text-subtle transition-transform duration-200 group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </summary>
          <p class="mt-3 text-body text-text-muted leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
