---
import type { Project } from '@/data/projects';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { slug, title, subtitle, techStack, status, links } = project;
---

<!--
  The whole card is clickable through the title link's stretched ::after overlay.
  The quick links are real <a> elements layered above it, so keyboards, screen
  readers and crawlers can reach them (no nested links, no JS).
-->
<div
  class="group relative block rounded-xl border border-border bg-bg p-4 sm:p-6 shadow-card overflow-hidden
         transition-all duration-200
         hover:-translate-y-0.5 hover:shadow-card-hover hover:border-border-hover
         focus-within:ring-2 focus-within:ring-accent focus-within:ring-offset-2 focus-within:ring-offset-bg"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <h3
        class="text-subtitle text-text truncate"
        transition:name={`project-title-${slug}`}
      >
        <a
          href={`/projects/${slug}`}
          class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-hidden"
        >
          {title}
        </a>
      </h3>
      <p class:list={['mt-1 text-small text-text-muted', featured ? 'line-clamp-3' : 'line-clamp-2']}>{subtitle}</p>
    </div>

    <!-- Quick links, above the card overlay -->
    <div class="relative z-10 flex items-center gap-2 shrink-0 text-text-subtle">
      {links.live && (
        <a
          href={links.live}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} live site`}
          class="p-1 rounded-sm hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} GitHub repository`}
          class="p-1 rounded-sm hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      )}
      {links.appStore && (
        <a
          href={links.appStore}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} App Store`}
          class="p-1 rounded-sm hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"></path>
            <path d="M10 2c1 .5 2 2 2 5"></path>
          </svg>
        </a>
      )}
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between gap-2">
    <p class="text-xs font-mono text-text-subtle truncate min-w-0">
      {featured ? techStack.join(' · ') : techStack.slice(0, 3).join(' · ')}
    </p>
    <StatusBadge status={status} />
  </div>
</div>
